{
	"name": "@sunsided/markdown-raycast",
	"version": "0.0.0",
	"description": "Walk through a Markdown file as a first-person raycaster maze: every rendered letter becomes a wall.",
	"keywords": [
		"markdown",
		"raycaster",
		"raycasting",
		"game",
		"svelte",
		"canvas"
	],
	"license": "EUPL-1.2 OR MIT OR Apache-2.0",
	"author": "Markus Mayer",
	"homepage": "https://sunsided.github.io/markdown-raycast/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sunsided/markdown-raycast.git"
	},
	"bugs": {
		"url": "https://github.com/sunsided/markdown-raycast/issues"
	},
	"type": "module",
	"packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"LICENSE-*"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"svelte": "./dist/svelte.js",
			"default": "./dist/svelte.js"
		},
		"./vanilla": {
			"types": "./dist/vanilla.svelte.d.ts",
			"default": "./dist/bundle/vanilla.js"
		},
		"./styles.css": "./dist/styles/tokens.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"package": "svelte-kit sync && svelte-package && vite build --config vite.vanilla.config.ts",
		"package:lint": "publint --strict"
	},
	"dependencies": {
		"marked": "^18.1.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
